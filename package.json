{
  "name": "tendd",
  "private": true,
  "version": "0.0.0",
  "description": "Tendd - the design engineering repository. This file exists so a receiver can run the instruments; nothing here is built, bundled or published.",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "check": "node design/kit/screens/rollout12.cjs && node design/kit/screens/quality13.cjs",
    "check:rollout": "node design/kit/screens/rollout12.cjs",
    "check:quality": "node design/kit/screens/quality13.cjs",
    "check:width": "node design/kit/screens/width12.cjs",
    "check:inert": "node design/kit/screens/inert12.cjs",
    "check:edges": "node design/kit/screens/edges13.cjs",
    "check:pages": "node design/kit/screens/pages13.cjs",
    "check:walk": "node design/kit/screens/walk13.cjs",
    "census": "node design/kit/screens/handoff13.cjs",
    "fp:before": "node design/kit/screens/fp12.cjs before",
    "fp:after": "node design/kit/screens/fp12.cjs after"
  },
  "devDependencies": {
    "playwright": "^1.47.0"
  }
}
