# Course working notes, kept in the repo tree but out of git and the Pages deploy
docs-course/

# macOS / tooling noise
.DS_Store
**/.DS_Store
.playwright-mcp/

# Local verification screenshots. The blanket is deliberate: a stage produces dozens
# of them and none belongs in the repository. What it also swallowed, silently and
# for months, is the one PNG the product ships: apple-touch-icon.png is named by 143
# pages and answered 404 on the live site until 2026-08-13, because a rule written
# for screenshots cannot tell a screenshot from an asset. An asset is whitelisted by
# NAME, and the four folders keep their whitelist for anything a stage still adds as
# a PNG rather than as a WebP.
*.png
!apple-touch-icon.png
!research/screens/*.png
!design/concept/assets/*.png
!wireframes/screens/*.png
!design/screens/*.png

# Installed by `npm install` so the instruments can find playwright locally.
# Nothing in this repository is built from it and nothing is published.
node_modules/
